<extension type="component" version="4.0.0" method="upgrade">
	<name>COM_ENGAGE</name>
	<creationDate>2026-10-03</creationDate>
	<author>Akeeba Ltd</author>
	<authorEmail>no-reply@akeeba.com</authorEmail>
	<authorUrl>https://www.akeeba.com</authorUrl>
	<copyright>Copyright (c)2020-2025 Nicholas K. Dionysopoulos / Akeeba Ltd</copyright>
	<license>GNU/GPL v3 or any later version</license>
	<version>3.4.2.1</version>
	<description>COM_ENGAGE_XML_DESCRIPTION</description>
	<namespace path="src">Akeeba\Component\Engage</namespace>

	<!-- Public front end files -->
	<files folder="frontend">
		<folder>forms</folder>
		<folder>src</folder>
		<folder>tmpl</folder>

		<filename>.htaccess</filename>
		<filename>web.config</filename>
	</files>

	<!-- Front end translation files -->
	<languages folder="frontend/language">
		<language tag="en-GB">en-GB/com_engage.ini</language>
		<language tag="es-ES">es-ES/com_engage.ini</language>
	</languages>

	<!-- Administrator back-end section -->
	<administration>
		<!-- Administration menu -->
		<menu>COM_ENGAGE</menu>

		<!-- Fork 0.6.24: submenu. Una instalacion nueva lo crea; Joomla NO toca el menu de una instalacion existente
		     ("Akeeba Engage", enlace index.php?option=com_engage), que desde 0.6.24 abre el panel de control. -->
		<submenu>
			<menu link="option=com_engage&amp;view=controlpanel">COM_ENGAGE_MENU_CONTROLPANEL</menu>
			<menu link="option=com_engage&amp;view=comments">COM_ENGAGE_MENU_COMMENTS</menu>
			<menu link="option=com_engage&amp;view=emailtemplates">COM_ENGAGE_MENU_EMAILTEMPLATES</menu>
		</submenu>

		<!-- Back-end files -->
		<files folder="backend">
			<folder>forms</folder>
			<folder>layout</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<folder>vendor</folder>

			<filename>access.xml</filename>
			<filename>config.xml</filename>

			<filename>.htaccess</filename>
			<filename>web.config</filename>
		</files>

		<!-- Back-end translation files -->
		<languages folder="backend/language">
			<language tag="en-GB">en-GB/com_engage.ini</language>
			<language tag="en-GB">en-GB/com_engage.sys.ini</language>



			<language tag="es-ES">es-ES/com_engage.ini</language>
			<language tag="es-ES">es-ES/com_engage.sys.ini</language>


		</languages>
	</administration>

	<!-- Media files -->
	<media destination="com_engage" folder="media">
		<folder>css</folder>
		<folder>fonts</folder>
		<folder>images</folder>
		<folder>js</folder>
		<filename>index.html</filename>
		<filename>joomla.asset.json</filename>
	</media>

	<!-- Database tables installation, uninstallation and update -->
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>

	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
</extension>
